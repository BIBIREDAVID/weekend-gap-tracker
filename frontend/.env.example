# Firebase web app config — Firebase Console → Project settings → Your apps → SDK setup and config.
# All VITE_-prefixed vars are inlined into the client bundle at build time (Vite convention);
# these are the public web config values, safe to ship (Firestore security rules do the real
# access control, not secrecy of these values).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
