{
  "name": "weekend-gap-tracker-functions",
  "description": "Firebase Functions backend for the Weekend Gap Tracker (BNB Chain tokenized-stocks hackathon)",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:signature": "node scripts/test-signature.js",
    "poll": "node scripts/run-poll.js",
    "trade": "node scripts/run-trade.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "ethers": "^6.17.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "dotenv": "^16.4.5"
  }
}
