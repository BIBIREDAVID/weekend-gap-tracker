# Binance Web3 API credentials — from https://web3.binance.com/en/dev-portal/project
# Used by scripts/test-signature.js, scripts/run-poll.js, and the Firebase
# emulator (via dotenv) for local dev. In GitHub Actions these are set as
# repo secrets instead (Settings > Secrets and variables > Actions):
#   OC_API_KEY, OC_SECRET_KEY, FINNHUB_API_KEY, FIREBASE_SERVICE_ACCOUNT_JSON
OC_API_KEY=
OC_SECRET_KEY=

# Real underlying market price — the RWA Data API's own `referencePrice`
# field turned out to be derived FROM tokenPrice (tokenPrice /
# tokenToShareRatio), not an independent quote, so it can't detect a real
# weekend gap (see NOTES.md). Finnhub fills that role instead. Free tier,
# no card required: https://finnhub.io/register
FINNHUB_API_KEY=

# Only needed to run scripts/run-poll.js locally (writes to real Firestore
# with the Admin SDK). Generate from Firebase console > Project settings >
# Service accounts > Generate new private key — it downloads a .json file.
#
# Easiest for local dev: point straight at that file (keep it OUTSIDE this
# repo, e.g. your Downloads folder — never commit it).
FIREBASE_SERVICE_ACCOUNT_PATH=
#
# Alternative, required for GitHub Actions (no file to point at there): the
# whole JSON collapsed to a single line, pasted as-is. A raw multi-line
# paste breaks a .env file (each line needs its own KEY=VALUE), but GitHub
# Actions secrets handle embedded newlines fine either way.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Only needed to run scripts/run-trade.js. The private key of the wallet
# that quotes/signs/settles trades — use a FRESH wallet funded with only
# the small amount you intend to trade, never your main wallet. Never
# commit a real value here.
WALLET_PRIVATE_KEY=

# Optional: that same wallet's public address. When set, scripts/run-poll.js
# (and the pollNow emulator trigger) also fetch its BNB/USDT/tracked-token
# balances and write them to Firestore for the dashboard's balance panel.
# Safe to set as a GitHub Actions repo secret — it's a public address, not
# the private key above.
WALLET_ADDRESS=
